# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# Grafana Configuration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_password_here

# Telegram Monitoring (for Alertmanager)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# N8N Configuration
# IMPORTANT: Generate with: openssl rand -base64 32
# This key encrypts credentials stored in the database. Keep it safe!
N8N_ENCRYPTION_KEY=your_encryption_key_here

# Optional: Additional N8N Configuration
# N8N_BASIC_AUTH_USER=your_n8n_user
# N8N_BASIC_AUTH_PASSWORD=your_n8n_password
